{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-video-pipeline.local/schemas/storyboard.schema.json",
  "title": "Storyboard Schema",
  "description": "AI 视频流水线分镜表 JSON Schema（对齐设计文档 v1.1 3.6 节字段实现）。",
  "type": "object",
  "additionalProperties": true,
  "required": ["title", "total_duration", "shots"],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "单集标题，必填且非空。"
    },
    "total_duration": {
      "type": "number",
      "minimum": 0,
      "description": "全片总时长（秒），必填。"
    },
    "tone": {
      "type": "string",
      "description": "整体情绪基调（如：温暖治愈、悬疑紧张、燃向热血）。"
    },
    "characters": {
      "type": "array",
      "description": "出场角色列表（四要素：name/appearance/personality/speech_style 必填，taboos 可选）。",
      "items": {
        "$ref": "#/$defs/character"
      }
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "description": "分镜列表，必填且至少 1 个镜头。",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["index", "duration", "visual"],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 1,
            "description": "镜头序号（从 1 开始），必填。"
          },
          "duration": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "镜头时长（秒），必填且大于 0。"
          },
          "scene": {
            "type": "string",
            "description": "场景描述。"
          },
          "action": {
            "type": "string",
            "description": "运镜/动作（如：推近、环绕、横移）。"
          },
          "mood": {
            "type": "string",
            "description": "镜头情绪。"
          },
          "visual": {
            "type": "string",
            "minLength": 1,
            "description": "画面描述（可落图），必填且非空。"
          },
          "narration": {
            "type": "string",
            "description": "旁白/台词。"
          },
          "first_frame_ref": {
            "type": "string",
            "description": "首帧参考：角色定妆图路径或 '无'。"
          },
          "last_frame_ref": {
            "type": "string",
            "description": "尾帧参考：角色定妆图路径或 '无'。"
          },
          "sound": {
            "type": "string",
            "description": "BGM/音效提示。"
          }
        }
      }
    }
  },
  "$defs": {
    "character": {
      "type": "object",
      "additionalProperties": true,
      "required": ["name", "appearance", "personality", "speech_style"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "角色名，必填。"
        },
        "appearance": {
          "type": "string",
          "minLength": 1,
          "description": "外貌，必填。"
        },
        "personality": {
          "type": "string",
          "minLength": 1,
          "description": "性格，必填。"
        },
        "speech_style": {
          "type": "string",
          "minLength": 1,
          "description": "说话方式，必填。"
        },
        "taboos": {
          "type": "string",
          "description": "禁忌（如：不能出现某元素/某动作）。"
        }
      }
    }
  }
}
